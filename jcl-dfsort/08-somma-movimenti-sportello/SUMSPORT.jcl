//SUMSPORT JOB (ACCT),'SOMMA SPORTELLI',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*------------------------------------------------------------
//* TOTALE DEI MOVIMENTI BANCARI PER SPORTELLO (SUM FIELDS)
//*  INPUT : USERID.MOVI.BANK.TEST      (FB, 1 RECORD PER MOV.)
//*  OUTPUT: USERID.MOVI.BANK.TOTSPORT  (1 RECORD PER SPORTELLO)
//*------------------------------------------------------------
//* STEP 1 - CANCELLAZIONE PREVENTIVA DELL'OUTPUT
//*  SET MAXCC=0 RENDE IL JOB RIESEGUIBILE ANCHE QUANDO
//*  IL DATASET NON ESISTE ANCORA (PRIMA ESECUZIONE).
//*------------------------------------------------------------
//STEPDEL  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE USERID.MOVI.BANK.TOTSPORT
  SET MAXCC=0
/*
//*------------------------------------------------------------
//* STEP 2 - RIFORMATTAZIONE, ORDINAMENTO E SOMMA
//*  INREC : COL  1-3  CODICE SPORTELLO (DA POS. 7 DELL'INPUT)
//*          COL  4    SPAZIO DI SEPARAZIONE
//*          COL  5-15 IMPORTO SU 11 CIFRE: '0000' + 7 CIFRE
//*                    (GLI ZERI DANNO SPAZIO ALLA SOMMA)
//*  SORT  : PER CODICE SPORTELLO CRESCENTE
//*  SUM   : SOMMA L'IMPORTO SULL'INTERO CAMPO DI 11 BYTE,
//*          LASCIANDO UN SOLO RECORD PER SPORTELLO
//*------------------------------------------------------------
//STEPSUM  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=USERID.MOVI.BANK.TEST,DISP=SHR
//SORTOUT  DD DSN=USERID.MOVI.BANK.TOTSPORT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=15,BLKSIZE=0)
//SYSIN    DD *
  INREC FIELDS=(1:7,3,5:C'0000',10,7)
  SORT FIELDS=(1,3,CH,A)
  SUM FIELDS=(5,11,ZD)
/*
