//GDGDEL   JOB (ACCT),'CANCELLA GDG',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*------------------------------------------------------------
//* JOB 3 - CANCELLA LA BASE GDG E TUTTE LE GENERAZIONI
//*  ANCORA CATALOGATE (OPZIONE FORCE).
//*  LE GENERAZIONI GIA' SCATALOGATE RESTANO SUL DISCO MA NON
//*  SONO PIU' RAGGIUNGIBILI TRAMITE IL CATALOGO.
//*  SET MAXCC=0 RENDE IL JOB RIESEGUIBILE ANCHE SE IL GDG
//*  NON ESISTE (EVITA RC=8 SULLA DELETE DI UN OGGETTO ASSENTE).
//*------------------------------------------------------------
//STEPDEL  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE USERID.MYGDG.TEST1 GDG FORCE
  SET MAXCC=0
/*
